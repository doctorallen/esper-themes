  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#75A6BE"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword"
      ],
      "settings": {
        "foreground": "#83BBE3"
      }
    },
    {
      "name": "Control keywords",
      "scope": [
        "keyword.control",
        "keyword.other",
        "punctuation.definition.keyword"
      ],
      "settings": {
        "foreground": "#83BBE3"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.logical",
        "keyword.operator.type"
      ],
      "settings": {
        "foreground": "#ABD3F0"
      }
    },
    {
      "name": "Storage",
      "scope": [
        "storage",
        "token.storage"
      ],
      "settings": {
        "foreground": "#83BBE3"
      }
    },
    {
      "name": "Storage modifiers",
      "scope": [
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#83BBE3"
      }
    },
    {
      "name": "Storage types",
      "scope": [
        "storage.type"
      ],
      "settings": {
        "foreground": "#CCA15A"
      }
    },
    {
      "name": "PHP visibility and storage modifiers",
      "scope": [
        "storage.modifier.php",
        "storage.modifier.visibility.php"
      ],
      "settings": {
        "foreground": "#83BBE3"
      }
    },
    {
      "name": "PHP function declarations",
      "scope": [
        "storage.type.function.php",
        "storage.type.function.arrow.php"
      ],
      "settings": {
        "foreground": "#E37A3B"
      }
    },
    {
      "name": "TypeScript export keywords",
      "scope": [
        "keyword.control.export.ts",
        "keyword.control.export.js"
      ],
      "settings": {
        "foreground": "#83BBE3"
      }
    },
    {
      "name": "TypeScript class keywords",
      "scope": [
        "storage.type.class.ts",
        "storage.type.class.js"
      ],
      "settings": {
        "foreground": "#83BBE3"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "constant.other.symbol",
        "constant.regexp",
        "markup.quoted"
      ],
      "settings": {
        "foreground": "#EDCE74"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.character.escape",
        "constant.escape"
      ],
      "settings": {
        "foreground": "#FFD08D"
      }
    },
    {
      "name": "Named constants and enum members",
      "scope": [
        "entity.name.constant",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#FFB070"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "support.other.variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.instance"
      ],
      "settings": {
        "foreground": "#D2EBFD"
      }
    },
    {
      "name": "Language variables",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#D2EBFD"
      }
    },
    {
      "name": "Function parameters",
      "scope": [
        "variable.parameter",
        "variable.parameter.function",
        "entity.name.variable.parameter",
        "function.parameter"
      ],
      "settings": {
        "foreground": "#D2EBFD"
      }
    },
    {
      "name": "Object properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.property-name",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#FFF9D8"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "entity.name.function.method",
        "entity.name.function.constructor",
        "variable.function"
      ],
      "settings": {
        "foreground": "#E37A3B"
      }
    },
    {
      "name": "Library functions",
      "scope": [
        "support.function",
        "support.function.construct",
        "keyword.other.special-method"
