  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#565F3D"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword"
      ],
      "settings": {
        "foreground": "#465F30"
      }
    },
    {
      "name": "Control keywords",
      "scope": [
        "keyword.control",
        "keyword.other",
        "punctuation.definition.keyword"
      ],
      "settings": {
        "foreground": "#465F30"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.logical",
        "keyword.operator.type"
      ],
      "settings": {
        "foreground": "#535C34"
      }
    },
    {
      "name": "Storage",
      "scope": [
        "storage",
        "token.storage"
      ],
      "settings": {
        "foreground": "#465F30"
      }
    },
    {
      "name": "Storage modifiers",
      "scope": [
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#465F30"
      }
    },
    {
      "name": "Storage types",
      "scope": [
        "storage.type"
      ],
      "settings": {
        "foreground": "#585B2C"
      }
    },
    {
      "name": "PHP visibility and storage modifiers",
      "scope": [
        "storage.modifier.php",
        "storage.modifier.visibility.php"
      ],
      "settings": {
        "foreground": "#465F30"
      }
    },
    {
      "name": "PHP function declarations",
      "scope": [
        "storage.type.function.php",
        "storage.type.function.arrow.php"
      ],
      "settings": {
        "foreground": "#7D5311"
      }
    },
    {
      "name": "TypeScript export keywords",
      "scope": [
        "keyword.control.export.ts",
        "keyword.control.export.js"
      ],
      "settings": {
        "foreground": "#465F30"
      }
    },
    {
      "name": "TypeScript class keywords",
      "scope": [
        "storage.type.class.ts",
        "storage.type.class.js"
      ],
      "settings": {
        "foreground": "#465F30"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "constant.other.symbol",
        "constant.regexp",
        "markup.quoted"
      ],
      "settings": {
        "foreground": "#79501A"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.character.escape",
        "constant.escape"
      ],
      "settings": {
        "foreground": "#964029"
      }
    },
    {
      "name": "Named constants and enum members",
      "scope": [
        "entity.name.constant",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#6F542A"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "support.other.variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.instance"
      ],
      "settings": {
        "foreground": "#29341D"
      }
    },
    {
      "name": "Language variables",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#29341D"
      }
    },
    {
      "name": "Function parameters",
      "scope": [
        "variable.parameter",
        "variable.parameter.function",
        "entity.name.variable.parameter",
        "function.parameter"
      ],
      "settings": {
        "foreground": "#29341D"
      }
    },
    {
      "name": "Object properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.property-name",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#3D4D28"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "entity.name.function.method",
        "entity.name.function.constructor",
        "variable.function"
      ],
      "settings": {
        "foreground": "#7D5311"
      }
    },
    {
      "name": "Library functions",
      "scope": [
        "support.function",
        "support.function.construct",
        "keyword.other.special-method"
      ],
      "settings": {
        "foreground": "#6F542A"
      }
    },
    {
      "name": "Library constants and variables",
      "scope": [
        "support.constant",
        "support.variable"
      ],
      "settings": {
        "foreground": "#6F542A"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "entity.name.function.decorator.ts",
        "support.token.decorator"
      ],
      "settings": {
        "foreground": "#964029"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.type.type-parameter",
        "support.type",
        "support.type.primitive"
      ],
      "settings": {
        "foreground": "#585B2C"
      }
    },
    {
      "name": "Class names and library classes",
      "scope": [
        "entity.name.class",
        "entity.name.type.class",
        "entity.other.inherited-class",
        "support.class",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#585B2C"
      }
    },
    {
      "name": "Namespaces and modules",
      "scope": [
        "entity.name.namespace",
        "entity.name.type.module"
      ],
      "settings": {
        "foreground": "#585B2C"
      }
    },
    {
      "name": "Tag names",
      "scope": [
        "entity.name.tag",
        "entity.name.tag.html",
        "entity.name.tag.xml",
        "support.tag"
      ],
      "settings": {
        "foreground": "#465F30"
      }
    },
    {
      "name": "Attribute names",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.xml",
        "entity.other.attribute-name.id",
        "entity.other.attribute-name.class"
      ],
      "settings": {
        "foreground": "#3D4D28"
      }
    },
    {
      "name": "HTML attribute values",
      "scope": [
        "string.quoted.double.html",
        "string.quoted.single.html",
        "string.unquoted.html"
      ],
      "settings": {
        "foreground": "#79501A"
      }
    },
    {
      "name": "Tag punctuation",
      "scope": [
        "punctuation.definition.tag",
        "punctuation.definition.tag.html",
        "punctuation.definition.tag.xml"
      ],
      "settings": {
        "foreground": "#535C34"
      }
    },
    {
      "name": "Markup headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#465F30"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal",
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#964029"
      }
    }
  ],
  "semanticTokenColors": {
    "comment": "#565F3D",
    "string": "#79501A",
    "number": "#964029",
    "regexp": "#79501A",
    "operator": "#535C34",
    "function": "#7D5311",
    "function.defaultLibrary": "#6F542A",
    "method": "#7D5311",
    "decorator": "#964029",
    "macro": "#465F30",
    "keyword": "#465F30",
    "modifier": "#465F30",
    "label": "#465F30",
    "event": "#465F30",
    "namespace": "#585B2C",
    "type": "#585B2C",
    "type.defaultLibrary": "#585B2C",
    "class": "#585B2C",
    "class.defaultLibrary": "#585B2C",
    "interface": "#585B2C",
    "enum": "#6F542A",
    "enumMember": "#6F542A",
    "typeParameter": "#585B2C",
    "variable": "#29341D",
    "variable.defaultLibrary": "#29341D",
    "variable.constant": "#6F542A",
    "variable.readonly": "#29341D",
    "property": "#3D4D28",
    "property.readonly": "#3D4D28",
    "member": "#3D4D28",
    "parameter": "#29341D",
    "method.defaultLibrary": "#6F542A"
  }
}
