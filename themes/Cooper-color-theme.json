  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#8F959A"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword"
      ],
      "settings": {
        "foreground": "#DCA24A"
      }
    },
    {
      "name": "Control keywords",
      "scope": [
        "keyword.control",
        "keyword.other",
        "punctuation.definition.keyword"
      ],
      "settings": {
        "foreground": "#DCA24A"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.logical",
        "keyword.operator.type"
      ],
      "settings": {
        "foreground": "#A7AFB4"
      }
    },
    {
      "name": "Storage",
      "scope": [
        "storage",
        "token.storage"
      ],
      "settings": {
        "foreground": "#DCA24A"
      }
    },
    {
      "name": "Storage modifiers",
      "scope": [
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#DCA24A"
      }
    },
    {
      "name": "Storage types",
      "scope": [
        "storage.type"
      ],
      "settings": {
        "foreground": "#AAC7BD"
      }
    },
    {
      "name": "PHP visibility and storage modifiers",
      "scope": [
        "storage.modifier.php",
        "storage.modifier.visibility.php"
      ],
      "settings": {
        "foreground": "#DCA24A"
      }
    },
    {
      "name": "PHP function declarations",
      "scope": [
        "storage.type.function.php",
        "storage.type.function.arrow.php"
      ],
      "settings": {
        "foreground": "#9FBFD4"
      }
    },
    {
      "name": "TypeScript export keywords",
      "scope": [
        "keyword.control.export.ts",
        "keyword.control.export.js"
      ],
      "settings": {
        "foreground": "#DCA24A"
      }
    },
    {
      "name": "TypeScript class keywords",
      "scope": [
        "storage.type.class.ts",
        "storage.type.class.js"
      ],
      "settings": {
        "foreground": "#DCA24A"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "constant.other.symbol",
        "constant.regexp",
        "markup.quoted"
      ],
      "settings": {
        "foreground": "#B5CFA5"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.character.escape",
        "constant.escape"
      ],
      "settings": {
        "foreground": "#E27D3C"
      }
    },
    {
      "name": "Named constants and enum members",
      "scope": [
        "entity.name.constant",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#F3C46E"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "support.other.variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.instance"
      ],
      "settings": {
        "foreground": "#EBE8E1"
      }
    },
    {
      "name": "Language variables",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#EBE8E1"
      }
    },
    {
      "name": "Function parameters",
      "scope": [
        "variable.parameter",
        "variable.parameter.function",
        "entity.name.variable.parameter",
        "function.parameter"
      ],
      "settings": {
        "foreground": "#EBE8E1"
      }
    },
    {
      "name": "Object properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.property-name",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#D6E4EE"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "entity.name.function.method",
        "entity.name.function.constructor",
        "variable.function"
      ],
      "settings": {
        "foreground": "#9FBFD4"
      }
    },
    {
      "name": "Library functions",
      "scope": [
        "support.function",
        "support.function.construct",
        "keyword.other.special-method"
      ],
      "settings": {
        "foreground": "#E4C596"
      }
    },
    {
      "name": "Library constants and variables",
      "scope": [
        "support.constant",
        "support.variable"
      ],
      "settings": {
        "foreground": "#F3C46E"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "entity.name.function.decorator.ts",
        "support.token.decorator"
      ],
      "settings": {
        "foreground": "#DB8543"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.type.type-parameter",
        "support.type",
        "support.type.primitive"
      ],
      "settings": {
        "foreground": "#AAC7BD"
      }
    },
    {
      "name": "Class names and library classes",
      "scope": [
        "entity.name.class",
        "entity.name.type.class",
        "entity.other.inherited-class",
        "support.class",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#AAC7BD"
      }
    },
    {
      "name": "Namespaces and modules",
      "scope": [
        "entity.name.namespace",
        "entity.name.type.module"
      ],
      "settings": {
        "foreground": "#AAC7BD"
      }
    },
    {
      "name": "Tag names",
      "scope": [
        "entity.name.tag",
        "entity.name.tag.html",
        "entity.name.tag.xml",
        "support.tag"
      ],
      "settings": {
        "foreground": "#F3C46E"
      }
    },
    {
      "name": "Attribute names",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.xml",
        "entity.other.attribute-name.id",
        "entity.other.attribute-name.class"
      ],
      "settings": {
        "foreground": "#D6E4EE"
      }
    },
    {
      "name": "HTML attribute values",
      "scope": [
        "string.quoted.double.html",
        "string.quoted.single.html",
        "string.unquoted.html"
      ],
      "settings": {
        "foreground": "#B5CFA5"
      }
    },
    {
      "name": "Tag punctuation",
      "scope": [
        "punctuation.definition.tag",
        "punctuation.definition.tag.html",
        "punctuation.definition.tag.xml"
      ],
      "settings": {
        "foreground": "#A7AFB4"
      }
    },
    {
      "name": "Markup headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#F3C46E"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal",
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#D9673B"
      }
    }
  ],
  "semanticTokenColors": {
    "comment": "#8F959A",
    "string": "#B5CFA5",
    "number": "#E27D3C",
    "regexp": "#B5CFA5",
    "operator": "#A7AFB4",
    "function": "#9FBFD4",
    "function.defaultLibrary": "#E4C596",
    "method": "#9FBFD4",
    "decorator": "#DB8543",
    "macro": "#DCA24A",
    "keyword": "#DCA24A",
    "modifier": "#DCA24A",
    "label": "#F3C46E",
    "event": "#F3C46E",
    "namespace": "#AAC7BD",
    "type": "#AAC7BD",
    "type.defaultLibrary": "#AAC7BD",
    "class": "#AAC7BD",
    "class.defaultLibrary": "#AAC7BD",
    "interface": "#AAC7BD",
    "enum": "#F3C46E",
    "enumMember": "#F3C46E",
    "typeParameter": "#AAC7BD",
    "variable": "#EBE8E1",
    "variable.defaultLibrary": "#EBE8E1",
    "variable.constant": "#F3C46E",
    "variable.readonly": "#EBE8E1",
    "property": "#D6E4EE",
    "property.readonly": "#D6E4EE",
    "member": "#D6E4EE",
    "parameter": "#EBE8E1",
    "method.defaultLibrary": "#E4C596"
  }
}
