  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#8E8BB3"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword"
      ],
      "settings": {
        "foreground": "#F25AA9"
      }
    },
    {
      "name": "Control keywords",
      "scope": [
        "keyword.control",
        "keyword.other",
        "punctuation.definition.keyword"
      ],
      "settings": {
        "foreground": "#F25AA9"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.logical",
        "keyword.operator.type"
      ],
      "settings": {
        "foreground": "#7CE6F0"
      }
    },
    {
      "name": "Storage",
      "scope": [
        "storage",
        "token.storage"
      ],
      "settings": {
        "foreground": "#F25AA9"
      }
    },
    {
      "name": "Storage modifiers",
      "scope": [
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#F25AA9"
      }
    },
    {
      "name": "Storage types",
      "scope": [
        "storage.type"
      ],
      "settings": {
        "foreground": "#AE9DFF"
      }
    },
    {
      "name": "PHP visibility and storage modifiers",
      "scope": [
        "storage.modifier.php",
        "storage.modifier.visibility.php"
      ],
      "settings": {
        "foreground": "#F25AA9"
      }
    },
    {
      "name": "PHP function declarations",
      "scope": [
        "storage.type.function.php",
        "storage.type.function.arrow.php"
      ],
      "settings": {
        "foreground": "#3FD8EA"
      }
    },
    {
      "name": "TypeScript export keywords",
      "scope": [
        "keyword.control.export.ts",
        "keyword.control.export.js"
      ],
      "settings": {
        "foreground": "#F25AA9"
      }
    },
    {
      "name": "TypeScript class keywords",
      "scope": [
        "storage.type.class.ts",
        "storage.type.class.js"
      ],
      "settings": {
        "foreground": "#F25AA9"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "constant.other.symbol",
        "constant.regexp",
        "markup.quoted"
      ],
      "settings": {
        "foreground": "#FF8B55"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.character.escape",
        "constant.escape"
      ],
      "settings": {
        "foreground": "#FF647E"
      }
    },
    {
      "name": "Named constants and enum members",
      "scope": [
        "entity.name.constant",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#F9737F"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "support.other.variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.instance"
      ],
      "settings": {
        "foreground": "#FF8B55"
      }
    },
    {
      "name": "Language variables",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#E7E8FF"
      }
    },
    {
      "name": "Function parameters",
      "scope": [
        "variable.parameter",
        "variable.parameter.function",
        "entity.name.variable.parameter",
        "function.parameter"
      ],
      "settings": {
        "foreground": "#E7E8FF"
      }
    },
    {
      "name": "Object properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.property-name",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#8F75FF"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "entity.name.function.method",
        "entity.name.function.constructor",
        "variable.function"
      ],
      "settings": {
        "foreground": "#3FD8EA"
      }
    },
    {
      "name": "Library functions",
      "scope": [
        "support.function",
        "support.function.construct",
        "keyword.other.special-method"
      ],
      "settings": {
        "foreground": "#93E0F5"
      }
    },
    {
      "name": "Library constants and variables",
      "scope": [
        "support.constant",
        "support.variable"
      ],
      "settings": {
        "foreground": "#F9737F"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "entity.name.function.decorator.ts",
        "support.token.decorator"
      ],
      "settings": {
        "foreground": "#3FD8EA"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.type.type-parameter",
        "support.type",
        "support.type.primitive"
      ],
      "settings": {
        "foreground": "#AE9DFF"
      }
    },
    {
      "name": "Class names and library classes",
      "scope": [
        "entity.name.class",
        "entity.name.type.class",
        "entity.other.inherited-class",
        "support.class",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#AE9DFF"
      }
    },
    {
      "name": "Namespaces and modules",
      "scope": [
        "entity.name.namespace",
        "entity.name.type.module"
      ],
      "settings": {
        "foreground": "#AE9DFF"
      }
    },
    {
      "name": "Tag names",
      "scope": [
        "entity.name.tag",
        "entity.name.tag.html",
        "entity.name.tag.xml",
        "support.tag"
      ],
      "settings": {
        "foreground": "#7CE6F0"
      }
    },
    {
      "name": "Attribute names",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.xml",
        "entity.other.attribute-name.id",
        "entity.other.attribute-name.class"
