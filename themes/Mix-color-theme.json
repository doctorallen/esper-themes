  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#9EA5BA"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword"
      ],
      "settings": {
        "foreground": "#BAA4E5"
      }
    },
    {
      "name": "Control keywords",
      "scope": [
        "keyword.control",
        "keyword.other",
        "punctuation.definition.keyword"
      ],
      "settings": {
        "foreground": "#BAA4E5"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.logical",
        "keyword.operator.type"
      ],
      "settings": {
        "foreground": "#41C4F7"
      }
    },
    {
      "name": "Storage",
      "scope": [
        "storage",
        "token.storage"
      ],
      "settings": {
        "foreground": "#41C4F7"
      }
    },
    {
      "name": "Storage modifiers",
      "scope": [
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#41C4F7"
      }
    },
    {
      "name": "Storage types",
      "scope": [
        "storage.type"
      ],
      "settings": {
        "foreground": "#FF977B"
      }
    },
    {
      "name": "PHP visibility and storage modifiers",
      "scope": [
        "storage.modifier.php",
        "storage.modifier.visibility.php"
      ],
      "settings": {
        "foreground": "#BAA4E5"
      }
    },
    {
      "name": "PHP function declarations",
      "scope": [
        "storage.type.function.php",
        "storage.type.function.arrow.php"
      ],
      "settings": {
        "foreground": "#41C4F7"
      }
    },
    {
      "name": "TypeScript export keywords",
      "scope": [
        "keyword.control.export.ts",
        "keyword.control.export.js"
      ],
      "settings": {
        "foreground": "#41C4F7"
      }
    },
    {
      "name": "TypeScript class keywords",
      "scope": [
        "storage.type.class.ts",
        "storage.type.class.js"
      ],
      "settings": {
        "foreground": "#BAA4E5"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "constant.other.symbol",
        "constant.regexp",
        "markup.quoted"
      ],
      "settings": {
        "foreground": "#FCC19F"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.character.escape",
        "constant.escape"
      ],
      "settings": {
        "foreground": "#41C4F7"
      }
    },
    {
      "name": "Named constants and enum members",
      "scope": [
        "entity.name.constant",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#EDB378"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "support.other.variable",
        "variable.other",
        "variable.other.readwrite",
