{
  "name": "esper-themes",
  "displayName": "Esper Themes",
  "publisher": "esperinnovations",
  "version": "0.12.0",
  "description": "High-contrast, film-inspired themes for Visual Studio Code: LCARS, Replicant, Oblivion, Synthwave, Tomcat, Fellowship, Cooper, Bluey, Bluey Night, Helix, a generated accessibility-aware Q theme, and Mix, which wears any theme's workbench around any other's editor colors.",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#16151C",
    "theme": "dark"
  },
  "main": "./extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/doctorallen/esper-themes.git"
  },
  "scripts": {
    "build:themes": "node scripts/build-themes.js",
    "capture:screenshots": "node scripts/capture-theme-screenshots.mjs",
    "build:census-page": "node scripts/build-census-page.js",
    "build:specimens-page": "node scripts/build-specimens-page.js",
    "package:vsix": "vsce package --no-dependencies --skip-license"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2"
  },
  "engines": {
    "vscode": "^1.136.0"
  },
  "categories": [
    "Themes"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:esperThemes.generateQTheme",
    "onCommand:esperThemes.saveQTheme",
    "onCommand:esperThemes.pickSavedQTheme",
    "onCommand:esperThemes.mixThemes"
  ],
  "contributes": {
    "commands": [
      {
        "command": "esperThemes.generateQTheme",
        "title": "Esper Themes: Generate Q Theme",
        "category": "Esper Themes"
      },
      {
        "command": "esperThemes.saveQTheme",
        "title": "Esper Themes: Save Current Q Theme",
        "category": "Esper Themes"
      },
      {
        "command": "esperThemes.pickSavedQTheme",
        "title": "Esper Themes: Pick Saved Q Theme",
        "category": "Esper Themes"
      },
      {
        "command": "esperThemes.mixThemes",
        "title": "Esper Themes: Mix Themes",
        "category": "Esper Themes"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "esperThemes.generateQTheme"
        },
        {
          "command": "esperThemes.saveQTheme"
        },
        {
          "command": "esperThemes.pickSavedQTheme"
        },
        {
          "command": "esperThemes.mixThemes"
        }
      ]
    },
    "themes": [
      {
        "label": "LCARS",
        "uiTheme": "vs-dark",
        "path": "./themes/LCARS-color-theme.json"
      },
      {
        "label": "Q",
        "uiTheme": "vs-dark",
        "path": "./themes/Q-color-theme.json"
      },
      {
        "label": "Replicant",
        "uiTheme": "vs-dark",
        "path": "./themes/Replicant-color-theme.json"
      },
      {
        "label": "Oblivion",
        "uiTheme": "vs-dark",
        "path": "./themes/Oblivion-color-theme.json"
      },
      {
        "label": "Synthwave",
        "uiTheme": "vs-dark",
        "path": "./themes/Synthwave-color-theme.json"
      },
      {
        "label": "Tomcat",
        "uiTheme": "vs-dark",
        "path": "./themes/Tomcat-color-theme.json"
      },
      {
        "label": "Fellowship",
        "uiTheme": "vs",
        "path": "./themes/Fellowship-color-theme.json"
      },
      {
        "label": "Cooper",
        "uiTheme": "vs-dark",
        "path": "./themes/Cooper-color-theme.json"
      },
      {
        "label": "Bluey",
        "uiTheme": "vs",
        "path": "./themes/Bluey-color-theme.json"
      },
      {
        "label": "Bluey Night",
        "uiTheme": "vs-dark",
        "path": "./themes/Bluey-Night-color-theme.json"
      },
      {
        "label": "Helix",
        "uiTheme": "vs-dark",
        "path": "./themes/Helix-color-theme.json"
      },
      {
        "label": "Mix",
        "uiTheme": "vs-dark",
        "path": "./themes/Mix-color-theme.json"
      }
    ]
  }
}
